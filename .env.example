# --- PostgreSQL ---
POSTGRES_DB=orchestrator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Host ports ---
# Backend REST API (Spring Boot) exposed on the host.
BACKEND_PORT=8080
# Python dataset-analysis service exposed on the host.
ANALYSIS_PORT=8000
# Frontend (nginx) exposed on the host — open this in the browser.
FRONTEND_PORT=3000

# --- Frontend build ---
# Base URL the React app uses for API calls. "/api" keeps requests same-origin;
# nginx proxies them to the backend container (see frontend/nginx.conf).
VITE_API_URL=/api
